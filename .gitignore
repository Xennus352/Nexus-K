# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma generated client
src/generated/

# slotopol game engine build
# engine/

# Original free asset packs (~146 MB) — kept locally, never committed and never
# served: they live at the repo root in assets/, outside public/, so Next.js
# neither copies them into the build nor exposes them over HTTP. public/gfx
# holds only the WebP derivatives the app loads.
# regenerate with: ./scripts/optimize-assets.sh
/assets/
/public/assets/

# source Laravel casino dump (168 MB) — kept locally, not committed.
# public/gfx/{brand,gateways,payments} + public/sfx hold the derivatives.
# regenerate with: ./scripts/optimize-upload-code.sh
/public/Upload_Code/

# Player-uploaded files (deposit slips) — never committed.
/var/
