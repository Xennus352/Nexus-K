// Casino side of the stack. The Go slotopol engine in /engine stays the single
// source of truth for play balances; everything here is the operator-facing
// record-keeping around it (money in, money out, the ledger, config).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ players */

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String
  /** uid of the matching account in the slotopol engine. */
  engineUid    Int?      @unique
  username     String    @default("")
  firstName    String    @default("")
  lastName     String    @default("")
  phone        String    @default("")
  country      String    @default("")
  avatar       String    @default("")
  status       String    @default("active") // active | blocked
  banReason    String    @default("")
  // MongoDB treats null as a value in unique indexes, so uniqueness for these two
  // is enforced in code (see lib/ids.ts) rather than by the database.
  refCode      String    @default("")
  refById      String?   @db.ObjectId
  refBy        User?     @relation("UserReferral", fields: [refById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referred     User[]    @relation("UserReferral")
  totalDeposit  Float     @default(0)
  totalWithdraw Float     @default(0)
  totalBet      Float     @default(0)
  totalWin      Float     @default(0)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  @@index([username])
  @@index([refCode])

  spins        Spin[]
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  transactions Transaction[]
  bonusClaims  BonusClaim[]
  tickets      SupportTicket[]
  messages     SupportMessage[]
  kyc          KycSubmission?
}

model Spin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alias     String   @default("")
  bet       Float    @default(0)
  win       Float    @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/* ------------------------------------------------------------------ admins */

model Admin {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  username     String    @unique
  email        String    @unique
  passwordHash String
  name         String    @default("")
  /** superadmin can manage admins and settings; manager is read-mostly. */
  role         String    @default("admin") // superadmin | admin | manager
  status       String    @default("active") // active | blocked
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

/* ---------------------------------------------------------------- settings */

model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String   @default("")
  group     String   @default("general") // general | payment | bonus | misc
  label     String   @default("")
  type      String   @default("text") // text | textarea | number | bool | secret
  updatedAt DateTime @updatedAt
}

/* ---------------------------------------------------------------- payments */

model Gateway {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  alias    String  @unique
  name     String
  /** manual | stripe | paypal | nowpayments — selects the driver in lib/payments. */
  driver   String  @default("manual")
  logo     String  @default("")
  currency String  @default("USD")
  /** JSON array of ISO currency codes the gateway accepts. */
  currencies String @default("[\"USD\"]")
  crypto   Boolean @default(false)
  minAmount Float   @default(5)
  maxAmount Float   @default(100000)
  /** Percentage + fixed fee taken off the deposit before coins are credited. */
  percentFee Float  @default(0)
  fixedFee  Float   @default(0)
  /** Currency units received per 1 coin. 1 for most, >1 for cheap rails. */
  rate      Float   @default(1)
  /** JSON object of driver credentials. Never sent to the browser verbatim. */
  config    String  @default("{}")
  /** Manual rails only: shown on the deposit instructions page. */
  instructions String @default("")
  /** Manual rails only: JSON array of {label, value, art}. */
  rails     String  @default("[]")
  status    Boolean @default(false)
  sort      Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits Deposit[]
}

model Deposit {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  trx         String    @unique
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gatewayId   String?   @db.ObjectId
  gateway     Gateway?  @relation(fields: [gatewayId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gatewayAlias String   @default("")
  /** Currency units the player sent. */
  amount      Float
  fee         Float     @default(0)
  /** Currency units actually credited: amount - fee. */
  net         Float     @default(0)
  /** Coins credited to the engine wallet: net / rate. */
  coins       Float     @default(0)
  currency    String    @default("USD")
  /** success | pending | cancel */
  status      String    @default("pending")
  /** Driver-side payment id (Stripe pi_, PayPal order id, NowPayments id…). */
  reference   String    @default("")
  payUrl      String    @default("")
  /** JSON driver payload — redirect urls, crypto addresses, pay addresses… */
  data        String    @default("{}")
  adminNote   String    @default("")
  ip          String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model WithdrawMethod {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  code       String  @unique
  logo       String  @default("")
  currency   String  @default("")
  minAmount  Float   @default(5)
  maxAmount  Float   @default(100000)
  percentFee Float   @default(0)
  fixedFee   Float   @default(0)
  rate       Float   @default(1)
  /** JSON array of {key,label,type} describing the payout fields to collect. */
  fields     String  @default("[]")
  status     Boolean @default(true)
  sort       Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  withdrawals Withdrawal[]
}

model Withdrawal {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  trx      String         @unique
  userId   String         @db.ObjectId
  user     User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  methodId String         @db.ObjectId
  method   WithdrawMethod @relation(fields: [methodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /** JSON object of the collected payout details (account number, wallet, …). */
  account  String         @default("{}")
  accountName String      @default("")
  /** Coins requested. */
  amount   Float
  fee      Float          @default(0)
  /** Coins deducted from the wallet: amount + fee. */
  charge   Float          @default(0)
  /** Currency units the player receives: amount / rate. */
  net      Float          @default(0)
  currency String         @default("USD")
  /** pending | success | cancel */
  status   String         @default("pending")
  adminNote String        @default("")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  paidAt   DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/* ------------------------------------------------------------------- ledger */

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  trx       String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /** deposit | withdrawal | bonus | referral | bet | win | adjustment | refund */
  type      String
  /** Signed coin amount. Credits positive, debits negative. */
  amount    Float
  /** Engine wallet after the movement. */
  balance   Float    @default(0)
  memo      String   @default("")
  /** Related deposit/withdrawal trx. */
  ref       String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model BonusClaim {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /** Dedupe key, e.g. daily:<userId>:2026-10-04. */
  claimKey  String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /** welcome | daily | referral | promo */
  kind      String
  amount    Float
  claimedAt DateTime @default(now())

  @@index([userId, kind])
}

/* ----------------------------------------------------------------- support */

model SupportTicket {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  ticket     String           @unique
  userId     String           @db.ObjectId
  user       User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject    String
  category   String           @default("general") // general | payment | bonus | account | game
  priority   String           @default("normal") // low | normal | high
  /** open | answered | closed */
  status     String           @default("open")
  lastReply  DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String        @db.ObjectId
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /** Denormalized from the ticket so admin queues can filter by player. */
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  author    String        @default("user")
  isAdmin   Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([userId, createdAt])
}

/* ---------------------------------------------------------------------- kyc */

model KycSubmission {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @unique @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /** JSON object of the submitted identity document fields. */
  data       String    @default("{}")
  /** pending | approved | rejected */
  status     String    @default("pending")
  reason     String    @default("")
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
}